moc_*.cpp
moc_*.cpp.d
moc_*.h
mocs_compilation.cpp
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
Makefile*
*build-*
*.qm
*.prl

# Qt unit tests
target_wrapper.*

