# Build directory. Ignore everything but dummyfile
build/*
!build/dummyfile

# Kate project
.kateproject.d/
.idea

.vagrant
*.user

changelog.gz

# Files configured & generated by CMake
doc/Doxyfile
src/config.h

# Build outputs
src/brewtarget
src/brewtarget_tests

# Qt Resources
brewtarget.qrc.depends


